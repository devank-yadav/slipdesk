# All optional for local development — the app runs with none of it set.
# Everything here is required in production.

# Flask session signing. Unset means a random key per process, which logs
# everyone out on every restart.
SECRET_KEY=

# Admin login password, synced into the database on startup.
# Locally, with this unset, the login falls back to admin / admin.
ADMIN_PASSWORD=

# Production database (libSQL / Turso). Unset means a local SQLite invoices.db.
# STORAGE_URL / STORAGE_AUTH_TOKEN are accepted as aliases for these.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Maps + Places for the route builder.
GOOGLE_MAPS_API_KEY=

# AI slip parsing. Provide one key to enable /ai/parse_slip and
# /ai/parse_slip_image; provide none and those endpoints stay off.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional. Which provider to use when both keys are present ("anthropic" or
# "openai"); otherwise Anthropic wins. AI_MODEL overrides the provider default
# (claude-3-5-sonnet-latest / gpt-4o).
AI_PROVIDER=
AI_MODEL=

# Set to 1 for Flask debug locally.
FLASK_DEBUG=
